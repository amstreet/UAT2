rules_version = '2';

// Firestore security rules for timothyehrlichmd.com
//
// The `leads` collection is written ONLY by the submitLead Cloud Function
// (using the Admin SDK, which bypasses these rules). Public web clients
// have no access at all — no read, no list, no write.
//
// Dr. Ehrlich reads submissions from the Firebase Console for now (the
// Console uses GCP IAM credentials, also bypassing these rules). If/when
// a custom admin web UI is built, this `match` block should be updated to
// allow read access to a specific authenticated user.

service cloud.firestore {
  match /databases/{database}/documents {

    match /leads/{leadId} {
      allow read, list, write: if false;
    }

    // Default deny for any other collection that may be added later.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
